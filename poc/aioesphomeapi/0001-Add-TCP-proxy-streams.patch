diff --git a/aioesphomeapi/tcp_proxy.py b/aioesphomeapi/tcp_proxy.py
new file mode 100644
index 0000000..536ca07
--- /dev/null
+++ b/aioesphomeapi/tcp_proxy.py
@@ -0,0 +1,266 @@
+"""Client side of the ESPHome TCP proxy: TCP streams relayed over the native API.
+
+PROOF OF CONCEPT. The device opens a TCP connection to one of the targets it was
+configured with (typically its own web server on 127.0.0.1) and relays bytes in
+both directions. Flow control is credit based: each side announces a receive
+window and returns credit as it consumes data, so neither side ever buffers more
+than it agreed to.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from collections import deque
+import contextlib
+import itertools
+import logging
+from typing import TYPE_CHECKING, Any
+
+from .api_pb2 import (  # type: ignore[attr-defined]
+    TcpProxyClose,
+    TcpProxyData,
+    TcpProxyOpenRequest,
+    TcpProxyOpenResponse,
+    TcpProxyWindowUpdate,
+)
+from .core import APIConnectionError
+from .model import TcpProxyStatus
+
+if TYPE_CHECKING:
+    from .connection import APIConnection
+
+_LOGGER = logging.getLogger(__name__)
+
+# How many bytes the device may send before we credit more. The device has no
+# buffer for this direction (it leaves unread data in its socket), so this only
+# bounds how much the client holds for a slow reader.
+TCP_PROXY_DEFAULT_WINDOW = 65536
+TCP_PROXY_OPEN_TIMEOUT = 10.0
+
+
+class TcpProxyError(APIConnectionError):
+    """A TCP proxy stream could not be opened or failed while open."""
+
+    def __init__(self, message: str, status: TcpProxyStatus | None = None) -> None:
+        super().__init__(message)
+        self.status = status
+
+
+class TcpProxyStream:
+    """One TCP connection relayed by the device.
+
+    read() returns b"" once the target closed the connection; send() waits for
+    flow control credit, so it applies backpressure to the caller.
+    """
+
+    __slots__ = (
+        "_buffer",
+        "_closed",
+        "_consumed",
+        "_data_event",
+        "_eof",
+        "_error",
+        "_manager",
+        "_max_data_size",
+        "_opened",
+        "_send_lock",
+        "_send_window",
+        "_window_event",
+        "stream_id",
+        "window",
+    )
+
+    def __init__(self, manager: TcpProxyStreams, stream_id: int, window: int) -> None:
+        self._manager = manager
+        self.stream_id = stream_id
+        self.window = window
+        self._buffer: deque[bytes] = deque()
+        self._consumed = 0
+        self._send_window = 0
+        self._max_data_size = 0
+        self._eof = False
+        self._closed = False
+        self._error: TcpProxyError | None = None
+        self._data_event = asyncio.Event()
+        self._window_event = asyncio.Event()
+        self._send_lock = asyncio.Lock()
+        self._opened: asyncio.Future[None] = manager.loop.create_future()
+
+    @property
+    def is_closed(self) -> bool:
+        return self._closed
+
+    async def read(self) -> bytes:
+        """Return the next chunk received from the target, or b"" at EOF."""
+        while not self._buffer:
+            if self._error is not None:
+                raise self._error
+            if self._eof or self._closed:
+                return b""
+            self._data_event.clear()
+            await self._data_event.wait()
+        data = self._buffer.popleft()
+        self._consumed += len(data)
+        # Credit the device once half the window is used, so it never stalls
+        # while we still have room
+        if self._consumed >= self.window // 2 and not self._closed:
+            self._manager.send(
+                TcpProxyWindowUpdate(stream_id=self.stream_id, increment=self._consumed)
+            )
+            self._consumed = 0
+        return data
+
+    async def send(self, data: bytes) -> None:
+        """Send data to the target, waiting for flow control credit as needed."""
+        view = memoryview(data)
+        async with self._send_lock:
+            while view:
+                if self._error is not None:
+                    raise self._error
+                if self._closed:
+                    msg = "Stream is closed"
+                    raise TcpProxyError(msg)
+                if self._send_window == 0:
+                    self._window_event.clear()
+                    await self._window_event.wait()
+                    continue
+                size = min(len(view), self._send_window, self._max_data_size)
+                self._manager.send(
+                    TcpProxyData(stream_id=self.stream_id, data=bytes(view[:size]))
+                )
+                self._send_window -= size
+                view = view[size:]
+
+    def close(self) -> None:
+        """Close the stream; data not yet read is discarded."""
+        if self._closed:
+            return
+        self._closed = True
+        self._manager.close_stream(self, notify=True)
+        self._wake()
+
+    async def wait_opened(self) -> None:
+        """Wait for the device to accept or refuse the stream."""
+        await self._opened
+
+    def _wake(self) -> None:
+        self._data_event.set()
+        self._window_event.set()
+
+    def on_open_response(self, msg: TcpProxyOpenResponse) -> None:
+        if self._opened.done():
+            return
+        status = TcpProxyStatus.convert(msg.status)
+        if status != TcpProxyStatus.OK:
+            self._closed = True
+            self._opened.set_exception(
+                TcpProxyError(f"Device refused stream: {status!r}", status)
+            )
+            return
+        self._send_window = msg.window
+        self._max_data_size = msg.max_data_size or msg.window
+        self._opened.set_result(None)
+
+    def on_data(self, msg: TcpProxyData) -> None:
+        if msg.data:
+            self._buffer.append(msg.data)
+            self._data_event.set()
+
+    def on_window_update(self, msg: TcpProxyWindowUpdate) -> None:
+        self._send_window += msg.increment
+        self._window_event.set()
+
+    def on_close(self, msg: TcpProxyClose) -> None:
+        status = TcpProxyStatus.convert(msg.status)
+        if status == TcpProxyStatus.OK:
+            self._eof = True
+        else:
+            self._error = TcpProxyError(f"Stream failed: {status!r}", status)
+        self._closed = True
+        self._wake()
+
+    def fail(self, error: TcpProxyError) -> None:
+        self._error = error
+        self._closed = True
+        if not self._opened.done():
+            self._opened.set_exception(error)
+        self._wake()
+
+
+class TcpProxyStreams:
+    """The TCP proxy streams of one API connection."""
+
+    __slots__ = ("_connection", "_ids", "_remove_callback", "_streams", "loop")
+
+    def __init__(
+        self, connection: APIConnection, loop: asyncio.AbstractEventLoop
+    ) -> None:
+        self._connection = connection
+        self.loop = loop
+        self._streams: dict[int, TcpProxyStream] = {}
+        # Never reuse an id on a connection: a late message for a closed stream
+        # must not be mistaken for one belonging to a new stream
+        self._ids = itertools.count(1)
+        self._remove_callback = connection.add_message_callback(
+            self._on_message,
+            (TcpProxyOpenResponse, TcpProxyData, TcpProxyWindowUpdate, TcpProxyClose),
+        )
+
+    def send(self, msg: Any) -> None:
+        self._connection.send_message(msg)
+
+    async def open(
+        self,
+        target: int,
+        window: int = TCP_PROXY_DEFAULT_WINDOW,
+        timeout: float = TCP_PROXY_OPEN_TIMEOUT,
+    ) -> TcpProxyStream:
+        stream_id = next(self._ids)
+        stream = TcpProxyStream(self, stream_id, window)
+        self._streams[stream_id] = stream
+        self.send(
+            TcpProxyOpenRequest(target=target, stream_id=stream_id, window=window)
+        )
+        try:
+            async with asyncio.timeout(timeout):
+                await stream.wait_opened()
+        except TimeoutError:
+            self.close_stream(stream, notify=True)
+            msg = f"Timed out opening stream to target {target}"
+            raise TcpProxyError(msg) from None
+        except TcpProxyError:
+            self._streams.pop(stream_id, None)
+            raise
+        return stream
+
+    def close_stream(self, stream: TcpProxyStream, notify: bool) -> None:
+        if self._streams.pop(stream.stream_id, None) is not None and notify:
+            # If the connection is gone, so is the stream
+            with contextlib.suppress(APIConnectionError):
+                self.send(TcpProxyClose(stream_id=stream.stream_id))
+
+    def _on_message(
+        self,
+        msg: TcpProxyOpenResponse | TcpProxyData | TcpProxyWindowUpdate | TcpProxyClose,
+    ) -> None:
+        if (stream := self._streams.get(msg.stream_id)) is None:
+            return  # Late message for a stream we already closed
+        if type(msg) is TcpProxyData:
+            stream.on_data(msg)
+        elif type(msg) is TcpProxyWindowUpdate:
+            stream.on_window_update(msg)
+        elif type(msg) is TcpProxyOpenResponse:
+            stream.on_open_response(msg)
+            if stream.is_closed:
+                self._streams.pop(msg.stream_id, None)
+        else:
+            self._streams.pop(msg.stream_id, None)
+            stream.on_close(msg)
+
+    def close(self) -> None:
+        """Fail every stream; the API connection went away."""
+        self._remove_callback()
+        streams = list(self._streams.values())
+        self._streams.clear()
+        for stream in streams:
+            stream.fail(TcpProxyError("API connection lost"))
