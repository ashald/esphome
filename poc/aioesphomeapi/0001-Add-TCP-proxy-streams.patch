+        if (tcp_proxy := self._tcp_proxy) is None:
+            tcp_proxy = self._tcp_proxy = TcpProxyStreams(
+                self._get_connection(), self._loop
+            )
+        return await tcp_proxy.open(target, window, timeout)
+
     def _supports_proxy_ack(self) -> bool:
         api_version = self.api_version
         return api_version is None or api_version >= MIN_VERSION_PROXY_ACK
