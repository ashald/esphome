 aioesphomeapi/client.py       |  26 +
 aioesphomeapi/client_base.pxd |   1 +
 aioesphomeapi/client_base.py  |   4 +
 aioesphomeapi/core.py         |  10 +
 aioesphomeapi/model.py        |  29 ++
 aioesphomeapi/tcp_proxy.py    | 266 ++++++++++
